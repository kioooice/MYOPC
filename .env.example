# 运行数据应放在公开代码仓库之外。
MYOPC_DATA_DIR=C:\path\to\private\myopc-data
MYOPC_BASE_URL=http://127.0.0.1:3000
MYOPC_USERNAME=
MYOPC_PASSWORD=
MYOPC_RELEASE=

# 知识仓库：OPC 读取 Markdown 内容并建立索引，不写入该仓库。
MYOPC_KNOWLEDGE_DIR=C:\path\to\MYOPC-Knowledge
MYOPC_KNOWLEDGE_REPO=kioooice/MYOPC-Knowledge

# 模型加工（阅读说明）。未配置密钥时同步和浏览仍可用，只有加工停在“模型未配置”。
MYOPC_MODEL=deepseek-flash
MYOPC_MODEL_BASE_URL=https://api.deepseek.com
MYOPC_MODEL_API_KEY=
MYOPC_MODEL_TIMEOUT_MS=60000
MYOPC_MODEL_MAX_TOKENS=4000
